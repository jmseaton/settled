# §3.2 archived broker payloads. These are real account statements —
# positions, P&L, cost basis — and must never reach source control. The
# fixtures README says it for the fixtures; it goes double for live data.
data/
backend/data/

__pycache__/
*.py[cod]
.venv/
venv/
.env

node_modules/
dist/
*.local

.pytest_cache/
.DS_Store

# §1.3a — TLS material. The private key is the whole of the transport's
# security and a certificate in git is a certificate to reissue.
# The directory itself is tracked (see certs/.gitkeep) so that Docker does
# not create it as root; its contents never are.
certs/*
!certs/.gitkeep
*.pem
*.key
