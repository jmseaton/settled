# Copy to `.env` beside docker-compose.yml and fill in. `.env` is gitignored.
#
# §3.10 — the Flex token grants read access to the full statement history:
# positions, P&L, cost basis. It lives here and nowhere else. It is never
# written to the database, never logged, and must never be committed.

# --- Database -------------------------------------------------------------
# Required. Any long random string; it is only ever used between containers.
#   openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_USER=settled
POSTGRES_DB=settled

# --- IBKR Flex Web Service (§3.6) -----------------------------------------
# Client Portal -> Performance & Reports -> Flex Queries.
#
# The query must be an *Activity* Flex Query with **Format: XML**. Format is
# a separate setting from the period and a text-configured query fails in a
# way that looks like nothing is wrong — both calls return 200 and the body
# is CSV. `docker compose exec backend python -m app.flex.diagnose` says so
# in as many words.
# Leave both blank to run upload-only: the app works, the scheduler simply
# never starts, and you import statements by hand.
#
# Tokens EXPIRE (commonly one year). An expired token stops the daily sync,
# which stops the mark history the excursion metrics are built from — so the
# staleness badge is worth glancing at. See docs/deployment.md.
SETTLED_FLEX_TOKEN=
SETTLED_FLEX_QUERY_ID=

# --- Benchmark price data (§7.5) ------------------------------------------
# Optional. Without a Tiingo key the app falls back to keyless Stooq, whose
# bars are price-only — benchmark returns then understate SPY by roughly its
# dividend yield per year, and the UI says so beside the number.
SETTLED_TIINGO_API_KEY=
SETTLED_PRICE_SOURCE=auto

# --- Behaviour ------------------------------------------------------------
# false drives sync externally (a host cron hitting the sync endpoint)
# instead of from the in-process scheduler.
SETTLED_SCHEDULER_ENABLED=true

# §14.6.3 — a display preference, not a statistical claim. Every Sharpe
# carries its own confidence interval regardless of this.
SETTLED_MIN_SAMPLE_TRADING_DAYS=30

# --- Authentication (§1.3a) -----------------------------------------------
# One owner, one password, one session cookie. There is no user table and
# no account creation: the password lives here, as a hash.
#
# Generate one — it prompts, so the password never lands in your shell
# history or in `ps`:
#
#   docker compose exec backend python -m app.auth
#
# Paste the whole `scrypt:...` line below. Leave it empty and the app runs
# with no authentication at all, exactly as it did before this existed — it
# says so on startup and in a banner on every page, so an open install is a
# choice rather than an oversight.
#
# Changing this logs every browser out, which is what you want from a
# password change. Restart the backend after editing.
SETTLED_AUTH_PASSWORD_HASH=

# Refuse to start rather than serve without a password. Off by default so
# an existing install upgrades without an outage; turn it on if you would
# rather have a crash-looping container than an open one.
SETTLED_AUTH_REQUIRED=false

# For non-browser callers — the host-cron sync below, mainly, which has no
# cookie jar. Sent as `Authorization: Bearer <token>`. Empty disables the
# bearer path entirely. Generate one with:
#   docker compose exec backend python -m app.auth --api-token
SETTLED_API_TOKEN=

# How long a session lasts before it has to be re-entered. Sliding: a
# browser in daily use is re-issued a cookie past the halfway mark and
# never hits the wall. 336 hours = 14 days.
SETTLED_SESSION_TTL_HOURS=336

# --- TLS (§1.3a) ----------------------------------------------------------
# nginx serves HTTPS when it finds ./certs/fullchain.pem and
# ./certs/privkey.pem, and plain HTTP when it does not.
#
#   ./scripts/generate-self-signed-cert.sh          # LAN, self-signed
#
# Or drop a Let's Encrypt pair in ./certs under those two names.
#
#   auto  serve TLS if a certificate is there, HTTP if not (default)
#   on    refuse to start without one
#   off   plain HTTP, no warning
SETTLED_TLS=auto

# HSTS — tells browsers never to use HTTP for this host again. Leave it off
# with a self-signed certificate: it turns the browser's click-through
# warning into a wall you cannot get past on the host you need to reach.
# Turn it on only with a certificate from a real CA.
SETTLED_HSTS=off

# --- Host binding ---------------------------------------------------------
# The published ports. SETTLED_TLS_PORT is also what the HTTP->HTTPS
# redirect points at, so it has to match what you publish.
#
# On a shared box set SETTLED_BIND=127.0.0.1 and reach it over an SSH
# tunnel — still the strongest option available, and it composes with the
# password rather than replacing it.
SETTLED_PORT=8080
SETTLED_TLS_PORT=8443
SETTLED_BIND=0.0.0.0
TZ=America/New_York
